# Public build-time env vars for the marketing site.
# Copy to `.env` for local builds. `.env` is gitignored.
#
# Both vars are PUBLIC — they end up in the rendered HTML on purpose.
# Never put secrets here. Worker-side secrets live in `server/.dev.vars` and
# are set on the Worker via `wrangler secret put` (see server/README.md).

# Google reCAPTCHA v3 site key.
# Pulled from https://www.google.com/recaptcha/admin → chancey.io site → Site key.
# Google enforces a per-domain allow-list on this key; an attacker copying it
# can't use it on a different host.
PUBLIC_RECAPTCHA_SITE_KEY=6LfKYdIsAAAAAG2exCOEtxpj5PSOfAnEOUw-xJ2F

# URL of the deployed Cloudflare Worker that handles contact form submissions.
# Set after `npm run deploy:prod` in /server. Override in CI via the
# repo's PUBLIC_CONTACT_ENDPOINT variable.
PUBLIC_CONTACT_ENDPOINT=https://chancey-contact.ninjaconsultingllc.workers.dev

# URL used by "Open web app" buttons. Production should use app.chancey.io;
# staging/PR builds should use stage.app.chancey.io.
PUBLIC_CHANCEY_APP_URL=https://app.chancey.io
