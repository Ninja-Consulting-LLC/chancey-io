---
import { navItems, site } from '../site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff6ec" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/logo.png" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Chancey home">
        <img src="/logo.png" alt="" width="40" height="40" />
        <span>Chancey</span>
      </a>
      <nav aria-label="Primary">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="brand compact" href="/" aria-label="Chancey home">
          <img src="/logo.png" alt="" width="32" height="32" />
          <span>Chancey</span>
        </a>
        <p>For adults 18+. Chancey is not a lottery retailer and does not sell tickets or pay prizes.</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/responsible-play">Responsible play</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fff6ec;
    --surface: #ffffff;
    --surface-alt: #fff0dd;
    --ink: #1b1410;
    --ink-soft: #64554b;
    --line: rgba(27, 20, 16, 0.12);
    --accent: #ff6b3d;
    --gold: #f5b82e;
    --blue: #4f8db8;
    --green: #1f9d5f;
    --red: #e8375c;
    --shadow: 0 22px 70px rgba(79, 57, 39, 0.14);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--bg);
    color: var(--ink);
  }

  a {
    color: inherit;
  }

  p {
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .site-header,
  .site-footer,
  main > section,
  main > article {
    padding-left: max(24px, calc((100vw - 1120px) / 2));
    padding-right: max(24px, calc((100vw - 1120px) / 2));
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 246, 236, 0.9);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .brand img {
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(255, 107, 61, 0.22);
  }

  .brand.compact {
    font-size: 1rem;
  }

  nav,
  .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  nav a,
  .footer-links a {
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  .footer-links a:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    align-items: center;
    gap: 56px;
    min-height: calc(100vh - 76px);
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--green);
    content: "";
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.04;
    letter-spacing: 0;
  }

  h1 {
    max-width: 780px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 700;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.7rem);
  }

  h3 {
    font-size: 1.25rem;
  }

  .lead {
    max-width: 660px;
    margin: 22px 0 0;
    font-size: 1.16rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0 18px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .button.primary {
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), var(--gold));
    color: white;
    box-shadow: 0 16px 38px rgba(255, 107, 61, 0.26);
  }

  .disclaimer {
    max-width: 680px;
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .phone-wrap {
    justify-self: center;
    width: min(100%, 390px);
  }

  .phone {
    position: relative;
    overflow: hidden;
    min-height: 650px;
    border: 12px solid #211814;
    border-radius: 42px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .phone-screen {
    min-height: 626px;
    padding: 28px 20px;
    background: linear-gradient(180deg, #fff6ec, #ffffff 52%, #fff0dd);
  }

  .ticket-card {
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    background: var(--surface);
    box-shadow: 0 14px 36px rgba(79, 57, 39, 0.08);
  }

  .ticket-card strong {
    display: block;
    margin-bottom: 10px;
  }

  .balls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ball {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 -4px 10px rgba(27, 20, 16, 0.12), 0 7px 16px rgba(27, 20, 16, 0.09);
    font-weight: 900;
  }

  .ball.red {
    background: var(--red);
    color: white;
  }

  .status-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 14px;
  }

  .stat {
    border-radius: 8px;
    padding: 14px;
    background: var(--surface-alt);
  }

  .stat span {
    display: block;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .stat b {
    display: block;
    margin-top: 6px;
    font-size: 1.35rem;
  }

  .band {
    padding-top: 82px;
    padding-bottom: 82px;
    background: var(--surface);
  }

  .band.alt {
    background: var(--surface-alt);
  }

  .section-head {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .card {
    min-height: 210px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    background: var(--surface);
  }

  .card .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: var(--ink);
    color: white;
    font-weight: 900;
  }

  .legal {
    max-width: 860px;
    padding-top: 72px;
    padding-bottom: 92px;
  }

  .legal h1 {
    font-size: clamp(2.4rem, 6vw, 4.7rem);
  }

  .legal section {
    margin-top: 36px;
  }

  .legal h2 {
    font-size: 1.45rem;
  }

  .notice {
    border: 1px solid rgba(232, 55, 92, 0.26);
    border-radius: 8px;
    padding: 16px;
    background: rgba(232, 55, 92, 0.07);
    color: var(--ink);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    border-top: 1px solid var(--line);
    padding-top: 34px;
    padding-bottom: 34px;
  }

  .site-footer p {
    max-width: 560px;
    margin: 12px 0 0;
    font-size: 0.92rem;
  }

  @media (max-width: 850px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    nav,
    .footer-links {
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 44px;
    }

    .phone-wrap {
      width: min(100%, 340px);
    }

    .phone {
      min-height: 560px;
      border-radius: 34px;
    }

    .phone-screen {
      min-height: 536px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .site-footer {
      flex-direction: column;
    }
  }
</style>
