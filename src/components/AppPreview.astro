---
import { createLocalPaths } from '../paths';

const paths = createLocalPaths(Astro.url.pathname);
---

<div class="phone-wrap" aria-label="Chancey app preview">
  <div class="phone">
    <div class="phone-screen">
      <img src={paths.asset('/logo.png')} alt="Chancey app icon" width="64" height="64" />
      <p class="eyebrow">Ticket saved</p>
      <h2>Powerball</h2>
      <div class="ticket-card">
        <strong>Tonight's draw</strong>
        <div class="balls" aria-label="Example saved numbers">
          <span class="ball">08</span>
          <span class="ball">17</span>
          <span class="ball">28</span>
          <span class="ball">42</span>
          <span class="ball">61</span>
          <span class="ball red">14</span>
        </div>
        <div class="status-row">
          <div class="stat">
            <span>Status</span>
            <b>Pending</b>
          </div>
          <div class="stat">
            <span>Saved</span>
            <b>12</b>
          </div>
        </div>
      </div>
      <div class="ticket-card">
        <strong>Quick builder</strong>
        <p>Mix favorite numbers with simple stats and save combinations for later.</p>
      </div>
    </div>
  </div>
</div>
