---
interface Props {
  name:
    | 'scan'
    | 'check'
    | 'spark'
    | 'shield'
    | 'history'
    | 'remind'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'plus'
    | 'minus'
    | 'check-mark'
    | 'x-mark'
    | 'bell'
    | 'home'
    | 'list'
    | 'wand'
    | 'profile'
    | 'sparkle'
    | 'clover'
    | 'mail'
    | 'lock'
    | 'globe'
    | 'lightning'
    | 'heart';
