---
import Icon from '../icons/Icon.astro';
import { site } from '../../site';
import { createLocalPaths } from '../../paths';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const paths = createLocalPaths(Astro.url.pathname);

const {
  eyebrow = 'One scan from now',
  heading = 'Free to start. Scan one ticket. See what you missed.',
  description = '5 free scans a month, no card, runs in your browser.',
  primaryLabel = 'Scan your first ticket',
  primaryHref = site.appUrl,
  secondaryLabel = 'See pricing',
  secondaryHref = paths.route('/pricing/'),
} = Astro.props;

const primaryIsApp = primaryHref.startsWith(site.appUrl);
---

<section class="section">
  <div class="container">
    <div class="cta-card">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h-section">{heading}</h2>
      <p>{description}</p>
      <div class="actions">
        <a
          class="button primary lg"
          href={primaryHref}
          target={primaryIsApp ? '_blank' : undefined}
          rel={primaryIsApp ? 'noopener noreferrer' : undefined}
          data-cta="cta-section-primary"
        >
          {primaryLabel}
          <Icon name="arrow-right" size={18} />
          {primaryIsApp && <span class="visually-hidden">(opens in a new tab)</span>}
        </a>
        <a class="button lg" href={secondaryHref}>
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
