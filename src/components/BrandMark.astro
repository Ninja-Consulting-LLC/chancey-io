---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = '' } = Astro.props;
---

<span class={`brand-mark ${className}`} style={`width:${size}px;height:${size}px;`}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <linearGradient id="bm-shine" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="rgba(255,255,255,0.95)" />
        <stop offset="100%" stop-color="rgba(255,255,255,0.4)" />
      </linearGradient>
    </defs>
    <path
      d="M12 3.4c1.7-1.5 3.6-1.6 4.6-.7.9.8.9 2.4-.4 3.9C15 8 13.7 8.7 12 8.7c-1.7 0-3-.7-4.2-2.1-1.3-1.5-1.3-3.1-.4-3.9 1-.9 2.9-.8 4.6.7Z"
      fill="white"
      opacity="0.92"
    ></path>
    <circle cx="12" cy="14.6" r="6.4" fill="white" opacity="0.96"></circle>
    <text
      x="12"
      y="17"
      text-anchor="middle"
      font-family="Georgia, serif"
      font-size="6.6"
      font-weight="700"
      fill="#ff6b3d"
    >
      C
    </text>
    <circle cx="18.4" cy="6.6" r="1.2" fill="url(#bm-shine)"></circle>
  </svg>
</span>
