---
import { footerLinks, site } from '../site';
import { createLocalPaths } from '../paths';
import BrandMark from './BrandMark.astro';

const paths = createLocalPaths(Astro.url.pathname);
const year = new Date().getFullYear();

function resolveHref(href: string, external: boolean | undefined): string {
  if (external) return href;
  return paths.route(href);
}
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-meta">
        <a class="brand" href={paths.route('/')} aria-label={`${site.name} home`}>
          <BrandMark size={32} />
          <span>{site.name}</span>
        </a>
        <p>
          A lottery tracker app for adults 18+. {site.name} is not a lottery retailer and does not
          sell tickets, pay prizes, or predict winning numbers.
        </p>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          {
            footerLinks.product.map((link) => {
              const isExternal = 'external' in link ? link.external : false;
              return (
                <li>
                  <a
                    href={resolveHref(link.href, isExternal)}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    data-cta={isExternal ? 'footer' : undefined}
                  >
                    {link.label}
                    {isExternal && <span class="visually-hidden">(opens in a new tab)</span>}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          {
            footerLinks.company.map((link) => (
              <li>
                <a href={paths.route(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          {
            footerLinks.legal.map((link) => (
              <li>
                <a href={paths.route(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>Play responsibly.</p>
    </div>
  </div>
</footer>
