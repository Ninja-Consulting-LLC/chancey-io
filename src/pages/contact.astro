---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

// Build-time public env vars (safe to expose in HTML).
// Set these in your build environment; if missing, defaults below kick in.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? '';
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
---

<BaseLayout
  title="Contact us — Send a message to the Chancey team"
  description="Send a message to the Chancey team. We reply within two business days."
  pageType="ContactPage"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact/' },
  ]}
>
  <section class="container">
    <div class="article">
      <header>
        <p class="eyebrow">Contact</p>
        <h1>Send us a message.</h1>
        <p class="lead">
          A real person reads every message and replies within two business days. For sensitive
          things — IDs, payment cards, passwords — please don't paste them here.
        </p>
      </header>

      <form
        id="contact-form"
        class="contact-form"
        data-endpoint={contactEndpoint}
        data-recaptcha-key={recaptchaSiteKey}
        novalidate
      >
        <div class="form-row">
          <div class="form-field">
            <label for="contact-name">Your name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="200"
              required
            />
          </div>

          <div class="form-field">
            <label for="contact-email">Your email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="200"
              required
            />
          </div>
        </div>

        <div class="form-field">
          <label for="contact-topic">What's this about?</label>
          <select id="contact-topic" name="topic" required>
            <option value="general">General question</option>
            <option value="support">Help with the app</option>
            <option value="privacy">Privacy or data request</option>
            <option value="feedback">Product feedback</option>
            <option value="bug">Bug report</option>
            <option value="security">Security issue</option>
          </select>
        </div>

        <div class="form-field">
          <label for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="7"
            maxlength="5000"
            required
          ></textarea>
          <span class="form-hint">Up to 5,000 characters.</span>
        </div>

        {/* Honeypot — hidden from humans, visible to dumb bots */}
        <div class="form-honeypot" aria-hidden="true">
          <label for="contact-website">Website (leave empty)</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="form-submit-row">
          <button type="submit" class="button primary lg">
            <span data-form-label="default">Send message</span>
            <span data-form-label="loading" hidden>Sending…</span>
            <Icon name="arrow-right" size={18} />
          </button>
          <p class="form-legal">
            Protected by reCAPTCHA. Google's
            <a href="https://policies.google.com/privacy" rel="noopener">Privacy</a>
            and <a href="https://policies.google.com/terms" rel="noopener">Terms</a> apply.
          </p>
        </div>

        <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  {
    recaptchaSiteKey && (
      <script
        is:inline
        async
        defer
        src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
      />
    )
  }

  <script>
    import '../scripts/contact-form';
  </script>
</BaseLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 8px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-field label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-base);
    transition: border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 140px;
    font-family: var(--font-sans);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 61, 0.18);
  }

  .contact-form[data-submitted='true'] .form-field input:invalid,
  .contact-form[data-submitted='true'] .form-field textarea:invalid {
    border-color: var(--red);
  }

  .form-hint {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* Honeypot — visually hidden but in the DOM */
  .form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  .form-submit-row .button {
    align-self: flex-start;
  }

  .form-submit-row button[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .form-legal {
    flex: 1 1 240px;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    line-height: 1.5;
    margin: 0;
  }

  .form-legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form-status {
    min-height: 0;
    padding: 0;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.55;
    transition: padding var(--duration-fast) var(--ease-out);
  }

  .form-status[data-status='loading'] {
    color: var(--ink-soft);
    padding: 14px 16px;
    background: var(--surface-alt);
  }

  .form-status[data-status='success'] {
    color: #0d5a35;
    padding: 14px 16px;
    background: var(--green-soft);
    border: 1px solid rgba(31, 157, 95, 0.3);
  }

  .form-status[data-status='error'] {
    color: #8a1738;
    padding: 14px 16px;
    background: var(--red-soft);
    border: 1px solid rgba(232, 55, 92, 0.3);
  }

  @media (max-width: 720px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
