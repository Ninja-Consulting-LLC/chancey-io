---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { createLocalPaths } from '../paths';

const paths = createLocalPaths(Astro.url.pathname);

const steps = [
  {
    n: '01',
    title: 'Buy the ticket like always',
    body: 'Chancey is not a seller. Buy your ticket the same place you always do, and keep the printed slip.',
  },
  {
    n: '02',
    title: 'Scan it',
    body: 'Take a photo of the slip. Chancey reads the numbers, the game, and the draw date. You confirm before it saves.',
  },
  {
    n: '03',
    title: 'Chancey checks the draw',
    body: 'When the lottery posts results, Chancey checks every saved ticket against the official numbers, all on its own.',
  },
  {
    n: '04',
    title: 'You find out',
    body: 'Each ticket gets a clear label: match, partial, or no match. If you won, claim the prize through the lottery with your slip.',
  },
];

const howToSchema = {
  name: 'How to track lottery tickets with Chancey',
  description:
    'Buy a lottery ticket as usual, scan it into Chancey, and Chancey checks every draw against the official results so you never miss a win.',
  steps: steps.map((s) => ({ name: s.title, text: s.body })),
};
---

<BaseLayout
  title="How Chancey works"
  description="Buy a ticket as usual, scan it, and Chancey checks every draw against the official results. Four steps, no slips to dig through later."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'How it works', href: '/how-it-works/' },
  ]}
  howTo={howToSchema}
>
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h1 class="h-display" style="font-size: clamp(2rem, 5.5vw, 3.6rem);">
          Know what every ticket did, automatically.
        </h1>
        <p class="lead">
          You play the lottery the way you always have. Chancey just keeps track and tells you
          the moment a saved ticket wins.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step-number">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="howto-questions">
        That is the whole thing. The number builder is a bonus if you ever want help picking a
        set. Questions? The <a href={paths.route('/support/')}>support page</a> has the full FAQ,
        or <a href={paths.route('/contact/')}>send us a message</a>.
      </p>
    </div>
  </section>

  <CtaSection
    eyebrow="One scan from now"
    heading="Don't let the next win slip by."
    description="Scan a ticket you already bought. 5 free scans a month, no card, runs in your browser."
  />
</BaseLayout>

<style>
  .steps {
    list-style: none;
  }

  .howto-questions {
    max-width: 640px;
    margin: clamp(36px, 5vw, 56px) auto 0;
    text-align: center;
    font-size: var(--text-base);
    color: var(--ink-soft);
    line-height: var(--leading-relaxed);
  }

  .howto-questions a {
    color: var(--accent-deep);
    font-weight: 700;
    text-decoration: none;
  }
</style>
