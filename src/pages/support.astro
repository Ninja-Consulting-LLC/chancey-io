---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import Icon from '../components/icons/Icon.astro';
import { faqs } from '../site';

const supportFaqs = faqs;
---

<BaseLayout
  title="Support — Help with picks, scanning, accounts, and privacy"
  description="Help with the Chancey number builder, ticket scanning, accounts, draws, and privacy. Send a message through our contact form."
  pageType="ContactPage"
  faqs={supportFaqs}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Support', href: '/support/' },
  ]}
>
  <section class="container">
    <div class="article">
      <header>
        <p class="eyebrow">Support</p>
        <h1>Help with Chancey.</h1>
        <p class="lead">
          Most answers are below. For anything else, send a message through our <a
            href="/contact/">contact form</a>. A real person reads every message and replies within
          two business days.
        </p>
      </header>

      <section>
        <h2>Get in touch</h2>
        <p>
          Use the <a href="/contact/">contact form</a> for any question — general help, privacy
          and data requests, product feedback, bug reports, or security issues. Pick the matching
          topic when you write so it lands with the right person.
        </p>
        <p>
          Tell us your device, your browser, and what happened. A screenshot helps. Don't send
          IDs, payment cards, or passwords.
        </p>
      </section>

      <section>
        <h2>Scanning tips</h2>
        <p>
          Use steady light, hold the ticket flat, and avoid glare. If a number won't read, retake
          the photo or tap to type the number before saving.
        </p>
        <ul>
          <li>Move other tickets out of the frame so only one shows.</li>
          <li>Wipe the camera lens — most blurry scans come from a smudge.</li>
          <li>Check that the game and draw date look right before tapping save.</li>
          <li>If the barcode won't read, the printed numbers are still enough.</li>
        </ul>
      </section>

      <section>
        <h2>Results and matching</h2>
        <p>
          After official results are available for a supported draw, Chancey checks the posted
          numbers against your saved tickets. It marks each ticket match, partial match, or no
          match. The lottery is always the source of truth for prize claims.
        </p>
        <div class="notice">
          <span class="notice-icon" aria-hidden="true"><Icon name="lightning" size={22} /></span>
          <div>
            <strong>Have a winner?</strong>
            Always claim wins through the lottery that issued the ticket. Chancey cannot pay
            prizes. Keep the original ticket safe.
          </div>
        </div>
      </section>

      <section>
        <h2>Accounts and sign-in</h2>
        <p>
          Sign in to sync your saved picks and tickets across devices. If you lose access, send a
          message through the <a href="/contact/">contact form</a> from the email tied to your
          account. Saved picks and tickets come back as long as the account is intact.
        </p>
        <h3>Subscriptions</h3>
        <p>
          The core experience is free. If we add paid features, we will price them clearly before
          you buy. Payments and cancellation instructions will be shown through the checkout or
          platform used for purchase.
        </p>
      </section>

      <section>
        <h2>Privacy &amp; data</h2>
        <p>
          To request access to your data, a correction, or deletion, send a message through the <a
            href="/contact/">contact form</a> and pick the "Privacy or data request" topic. We
          reply within the windows the law requires (usually 30 days). The full <a href="/privacy/"
            >Privacy policy</a> has more.
        </p>
      </section>

      <section>
        <h2>Reporting a bug or a security issue</h2>
        <p>
          Found a bug? Send a message through the <a href="/contact/">contact form</a> and pick
          the "Bug report" topic. For security issues, pick "Security issue" — and please don't
          post the details in public until we've had a chance to fix it.
        </p>
      </section>
    </div>
  </section>

  <FaqSection
    eyebrow="Help center"
    heading="Common questions about Chancey."
    description="Twelve of the questions we hear most. If yours is missing, write to us."
    faqs={supportFaqs}
  />

  <CtaSection
    heading="Still stuck? Drop us a note."
    description="Send a message through the contact form. A real person reads every message and replies within two business days."
    primaryLabel="Open contact form"
    primaryHref="/contact/"
    secondaryLabel="Read the FAQ"
    secondaryHref="#main"
  />
</BaseLayout>
