---
const apiBase = import.meta.env.PUBLIC_CHANCEY_API_BASE_URL ?? '';
const clerkKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <title>Chancey Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  </head>
  <body>
    <main class="admin-shell" data-api-base={apiBase} data-clerk-key={clerkKey}>
      <section class="admin-hero">
        <div>
          <p class="eyebrow">Internal</p>
          <h1>Chancey Admin</h1>
          <p class="subhead">Launch metrics from official and first-party sources.</p>
        </div>
        <div class="admin-actions">
          <button id="sign-in" type="button">Sign in</button>
          <button id="refresh" type="button" disabled>Refresh</button>
        </div>
      </section>

      <section id="status" class="status">Loading admin session…</section>

      <section class="kpi-grid" aria-label="Key metrics">
        <article><span>Visitors</span><strong data-kpi="websiteVisitors">—</strong></article>
        <article><span>iOS downloads</span><strong data-kpi="iosDownloads">—</strong></article>
        <article><span>Android installs</span><strong data-kpi="androidInstalls">—</strong></article>
        <article><span>New users</span><strong data-kpi="newUsers">—</strong></article>
        <article><span>DAU</span><strong data-kpi="dau">—</strong></article>
        <article><span>Scans</span><strong data-kpi="scans">—</strong></article>
        <article><span>Pro events</span><strong data-kpi="proEvents">—</strong></article>
        <article><span>OCR cost</span><strong data-kpi="ocrCostUsd">—</strong></article>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>30-day trend</h2>
          <span id="range">—</span>
        </div>
        <div id="trend" class="trend" aria-label="30-day analytics trend"></div>
      </section>

      <section class="split">
        <article class="panel">
          <h2>Source health</h2>
          <div id="sources" class="rows"></div>
        </article>
        <article class="panel">
          <h2>Tickets</h2>
          <div id="tickets" class="rows"></div>
        </article>
      </section>

      <section class="split">
        <article class="panel">
          <h2>Top pages</h2>
          <div id="top-pages" class="rows"></div>
        </article>
        <article class="panel">
          <h2>Scan errors</h2>
          <div id="scan-errors" class="rows"></div>
        </article>
      </section>
    </main>
    <script>
      import '../scripts/admin-analytics';
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #fff6ec;
    --panel: #ffffff;
    --panel-alt: #fff0dd;
    --ink: #1b1410;
    --muted: #6b5b50;
    --line: rgba(27, 20, 16, 0.12);
    --accent: #ff6b3d;
    --good: #1f9d5f;
    --warn: #b77b00;
    --bad: #d93554;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
  }

  .admin-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 48px;
  }

  .admin-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 15px;
  }

  .subhead {
    margin-top: 10px;
    color: var(--muted);
  }

  .admin-actions {
    display: flex;
    gap: 10px;
  }

  button {
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink);
    padding: 0 18px;
    font-weight: 800;
  }

  button:not(:disabled):hover {
    border-color: var(--accent);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .status,
  .panel,
  .kpi-grid article {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    box-shadow: 0 10px 30px rgba(55, 35, 19, 0.06);
  }

  .status {
    margin-bottom: 14px;
    padding: 14px 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .status.ok {
    color: var(--good);
  }

  .status.error {
    color: var(--bad);
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 12px;
  }

  .kpi-grid article {
    min-height: 104px;
    padding: 18px;
  }

  .kpi-grid span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kpi-grid strong {
    display: block;
    margin-top: 12px;
    font-size: 30px;
    letter-spacing: -0.02em;
  }

  .panel {
    padding: 18px;
    margin-bottom: 12px;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }

  .panel-head h2 {
    color: var(--ink);
  }

  .trend {
    display: flex;
    align-items: end;
    gap: 5px;
    min-height: 180px;
    padding-top: 20px;
  }

  .bar {
    flex: 1;
    min-width: 6px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, #ff6b3d, #f5b82e);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .rows {
    margin-top: 12px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--line);
    padding: 11px 0;
    color: var(--muted);
    font-size: 14px;
  }

  .row strong {
    color: var(--ink);
  }

  .pill {
    border-radius: 999px;
    padding: 3px 8px;
    background: var(--panel-alt);
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .pill.ok {
    color: var(--good);
  }

  .pill.stale,
  .pill.unconfigured {
    color: var(--warn);
  }

  .pill.error {
    color: var(--bad);
  }

  @media (max-width: 760px) {
    .admin-hero,
    .split {
      grid-template-columns: 1fr;
      display: grid;
    }

    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-actions {
      justify-content: start;
    }
  }
</style>
