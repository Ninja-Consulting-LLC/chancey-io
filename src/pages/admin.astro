---
const PROD_API_BASE = 'https://chancey-api.ninjaconsultingllc.workers.dev';
const apiBase = PROD_API_BASE;
const clerkKey =
  import.meta.env.PUBLIC_CHANCEY_ADMIN_CLERK_PUBLISHABLE_KEY ??
  import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ??
  '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <title>Chancey Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  </head>
  <body>
    <main class="admin-shell" data-api-base={apiBase} data-clerk-key={clerkKey}>
      <section class="admin-hero">
        <div>
          <p class="eyebrow">Internal</p>
          <h1>Chancey Admin</h1>
          <p class="subhead">Launch metrics from official and first-party sources.</p>
        </div>
        <div class="admin-actions">
          <button id="sign-in" type="button">Sign in</button>
          <button id="refresh" type="button" disabled>Refresh</button>
        </div>
      </section>

      <section id="status" class="status">Loading admin session…</section>

      <section class="range-controls" aria-label="Metric period">
        <button type="button" data-range-days="7">7 days</button>
        <button type="button" data-range-days="30" class="active">30 days</button>
        <button type="button" data-range-days="90">90 days</button>
        <button type="button" data-range-days="180">180 days</button>
        <button type="button" data-range-days="all">All days</button>
      </section>

      <section class="kpi-grid" aria-label="Key metrics">
        <article tabindex="0" data-tooltip="Unique visitors to chancey.io from Cloudflare over the selected period."><span>Visitors</span><strong data-kpi="websiteVisitors">—</strong><small data-kpi-note="websiteVisitors"></small></article>
        <article tabindex="0" data-tooltip="First-time iOS downloads from App Store Connect sales and trends reports."><span>iOS downloads</span><strong data-kpi="iosDownloads">—</strong><small data-kpi-note="iosDownloads"></small></article>
        <article tabindex="0" data-tooltip="Android install counts imported from Google Play bulk install reports."><span>Android installs</span><strong data-kpi="androidInstalls">—</strong><small data-kpi-note="androidInstalls"></small></article>
        <article tabindex="0" data-tooltip="New Clerk users created during the selected period."><span>New users</span><strong data-kpi="newUsers">—</strong><small data-kpi-note="newUsers"></small></article>
        <article tabindex="0" data-tooltip="Daily active users counted from first-party app activity dedupe."><span>DAU</span><strong data-kpi="dau">—</strong><small data-kpi-note="dau"></small></article>
        <article tabindex="0" data-tooltip="Ticket scan attempts recorded by the Chancey API."><span>Scans</span><strong data-kpi="scans">—</strong><small data-kpi-note="scans"></small></article>
        <article tabindex="0" data-tooltip="RevenueCat subscription lifecycle events: purchases, renewals, cancellations, and expirations."><span>Subscription events</span><strong data-kpi="proEvents">—</strong><small data-kpi-note="proEvents"></small></article>
        <article tabindex="0" data-tooltip="Estimated OCR spend from first-party scan accounting, shown to three significant digits."><span>OCR cost</span><strong data-kpi="ocrCostUsd">—</strong><small data-kpi-note="ocrCostUsd"></small></article>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Trend</h2>
          <span id="range">Last 30 days · —</span>
        </div>
        <div id="trend" class="trend" aria-label="Analytics trend"></div>
      </section>

      <section class="split">
        <article class="panel">
          <h2>Source health</h2>
          <div id="sources" class="rows"></div>
        </article>
        <article class="panel">
          <h2>Tickets</h2>
          <div id="tickets" class="rows"></div>
        </article>
      </section>

      <section class="panel">
        <h2>Scan errors</h2>
        <div id="scan-errors" class="rows"></div>
      </section>
    </main>
    <script>
      import '../scripts/admin-analytics';
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #fff6ec;
    --panel: #ffffff;
    --panel-alt: #fff0dd;
    --ink: #1b1410;
    --muted: #6b5b50;
    --line: rgba(27, 20, 16, 0.12);
    --accent: #ff6b3d;
    --good: #1f9d5f;
    --warn: #b77b00;
    --bad: #d93554;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
  }

  .admin-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 48px;
  }

  .admin-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 15px;
  }

  .subhead {
    margin-top: 10px;
    color: var(--muted);
  }

  .admin-actions {
    display: flex;
    gap: 10px;
  }

  button {
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink);
    padding: 0 18px;
    font-weight: 800;
  }

  button:not(:disabled):hover {
    border-color: var(--accent);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .status,
  .panel,
  .kpi-grid article {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    box-shadow: 0 10px 30px rgba(55, 35, 19, 0.06);
  }

  .status {
    margin-bottom: 14px;
    padding: 14px 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .status.ok {
    color: var(--good);
  }

  .status.error {
    color: var(--bad);
  }

  .range-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
  }

  .range-controls button {
    min-height: 34px;
    padding: 0 13px;
    font-size: 13px;
  }

  .range-controls button.active {
    border-color: var(--accent);
    background: var(--ink);
    color: #fff;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 12px;
  }

  .kpi-grid article {
    position: relative;
    min-height: 104px;
    padding: 18px;
  }

  .kpi-grid article::after {
    content: "?";
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
  }

  .kpi-grid article::before {
    content: attr(data-tooltip);
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 16px;
    top: 44px;
    display: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.35;
    box-shadow: 0 12px 30px rgba(27, 20, 16, 0.2);
  }

  .kpi-grid article:hover::before,
  .kpi-grid article:focus::before {
    display: block;
  }

  .kpi-grid span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kpi-grid strong {
    display: block;
    margin-top: 12px;
    font-size: 30px;
    letter-spacing: -0.02em;
  }

  .kpi-grid small {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.35;
   }

  .panel {
    padding: 18px;
    margin-bottom: 12px;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }

  .panel-head h2 {
    color: var(--ink);
  }

  .trend {
    display: grid;
    gap: 14px;
    min-height: 180px;
    padding-top: 20px;
  }

  .trend :global(.trend-row) {
    display: grid;
    gap: 8px;
  }

  .trend :global(.trend-label) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .trend :global(.trend-bars) {
    display: flex;
    align-items: end;
    gap: 4px;
    height: 32px;
  }

  .trend :global(.bar) {
    flex: 1;
    min-width: 6px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, #ff6b3d, #f5b82e);
  }

  .trend :global(.empty-state) {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 180px;
    color: var(--muted);
    font-size: 14px;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .rows {
    margin-top: 12px;
  }

  .rows :global(.row) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--line);
    padding: 11px 0;
    color: var(--muted);
    font-size: 14px;
  }

  .rows :global(.row.empty) {
    justify-content: flex-start;
  }

  .rows :global(.row-copy) {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .rows :global(.row-copy small) {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .rows :global(.row strong) {
    color: var(--ink);
    flex: 0 0 auto;
    text-align: right;
  }

  .rows :global(.pill) {
    border-radius: 999px;
    padding: 3px 8px;
    background: var(--panel-alt);
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .rows :global(.pill.ok) {
    color: var(--good);
  }

  .rows :global(.pill.stale),
  .rows :global(.pill.unconfigured) {
    color: var(--warn);
  }

  .rows :global(.pill.error) {
    color: var(--bad);
  }

  @media (max-width: 760px) {
    .admin-hero,
    .split {
      grid-template-columns: 1fr;
      display: grid;
    }

    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-actions {
      justify-content: start;
    }
  }
</style>
