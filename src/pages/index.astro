---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import FeatureBlock from '../components/sections/FeatureBlock.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { createLocalPaths } from '../paths';
import { featureBlocks, homeFaqs, pricing, site } from '../site';

const paths = createLocalPaths(Astro.url.pathname);
const annualMonthly = (pricing.annualUsd / 12).toFixed(2);
---

<BaseLayout
  title="Chancey, Never wonder if you won. Scan tickets, auto-check every draw."
  description="Chancey is a lottery ticket tracker for adults 18+. Scan a ticket you already bought and Chancey checks every draw against the official results. Free for 5 scans a month, no ads."
  includeApplication={true}
  faqs={homeFaqs}
>
  <section class="hero-band">
    <div class="container">
      <div class="hero" data-hero-variant={site.heroVariant}>
        <div class="hero-copy">
          <p class="eyebrow">Lottery ticket tracker · Adults 18+</p>
          <h1 class="h-display hero-title">
            Never wonder<br class="hero-break" /> if you won again.
          </h1>
          <p class="lead lead-lg hero-sub">
            Scan a ticket you already bought. Chancey checks every draw against the official
            results, so a win never gets past you.
          </p>
          <div class="actions">
            <a
              class="button primary lg"
              href={site.appUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-cta="hero-primary"
            >
              Scan your first ticket
              <Icon name="arrow-right" size={18} />
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
            <a class="button lg" href={paths.route('/how-it-works/')}>See how it works</a>
          </div>
          <p class="cta-subtext">
            {pricing.freeScansPerMonth} free scans a month. No card. Runs in your browser.
          </p>
          <StoreBadges source="hero" />
        </div>
        <div class="hero-visual">
          <Screenshot
            variant="home"
            alt="The Chancey app showing saved lottery tickets and their draw results"
            label="Chancey"
            frame="phone"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="trust-strip">
      <div class="trust-item">
        <span class="label">Free tier</span>
        <span class="value">{pricing.freeScansPerMonth} scans/mo</span>
      </div>
      <div class="trust-item">
        <span class="label">Predictions</span>
        <span class="value">None, ever</span>
      </div>
      <div class="trust-item">
        <span class="label">In-app ads</span>
        <span class="value">Zero</span>
      </div>
      <div class="trust-item">
        <span class="label">Source of truth</span>
        <span class="value">Official lottery</span>
      </div>
    </div>
  </section>

  <div id="features"></div>

  <FeatureBlock
    eyebrow={featureBlocks[0].eyebrow}
    title={featureBlocks[0].title}
    description={featureBlocks[0].description}
    bullets={featureBlocks[0].bullets}
    background="cream"
    id={`feature-${featureBlocks[0].id}`}
  >
    <Screenshot
      alt={featureBlocks[0].screenshotAlt}
      label={featureBlocks[0].screenshotLabel}
      variant={featureBlocks[0].previewVariant as any}
      frame="phone"
    />
  </FeatureBlock>

  <FeatureBlock
    eyebrow={featureBlocks[1].eyebrow}
    title={featureBlocks[1].title}
    description={featureBlocks[1].description}
    bullets={featureBlocks[1].bullets}
    reverse={true}
    id={`feature-${featureBlocks[1].id}`}
  >
    <Screenshot
      alt={featureBlocks[1].screenshotAlt}
      label={featureBlocks[1].screenshotLabel}
      variant={featureBlocks[1].previewVariant as any}
      frame="phone"
    />
  </FeatureBlock>

  <FeatureBlock
    eyebrow={featureBlocks[2].eyebrow}
    title={featureBlocks[2].title}
    description={featureBlocks[2].description}
    bullets={featureBlocks[2].bullets}
    background="cream"
    id={`feature-${featureBlocks[2].id}`}
  >
    <Screenshot
      alt={featureBlocks[2].screenshotAlt}
      label={featureBlocks[2].screenshotLabel}
      variant={featureBlocks[2].previewVariant as any}
      frame="phone"
    />
  </FeatureBlock>

  {/* Pricing, compact */}
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Pricing</p>
        <h2 class="h-section">Free to start. Cheap to go unlimited.</h2>
        <p class="lead">
          Only the number of new scans is limited. The builder, your full history, and
          automatic draw checking are free on every plan.
        </p>
      </div>
      <div class="pricing-grid">
        <article class="pricing-card">
          <p class="pricing-name">Free</p>
          <p class="pricing-price"><span>$0</span></p>
          <p class="pricing-note">forever, no card</p>
          <ul class="plan-list">
            <li>{pricing.freeScansPerMonth} ticket scans a month</li>
            <li>Automatic draw checking</li>
            <li>Full searchable history</li>
            <li>Number builder</li>
          </ul>
          <a
            class="button lg"
            href={site.appUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="pricing-free"
          >
            Start free
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </article>
        <article class="pricing-card featured">
          <p class="pricing-name">Pro</p>
          <p class="pricing-price"><span>${pricing.monthlyUsd}</span><small>/mo</small></p>
          <p class="pricing-note">
            or ${pricing.annualUsd} a year, about ${annualMonthly}/mo
          </p>
          <ul class="plan-list">
            <li><strong>Unlimited</strong> ticket scans</li>
            <li>Everything in Free</li>
            <li>Still no ads</li>
            <li>Cancel anytime</li>
          </ul>
          <a
            class="button primary lg"
            href={site.appUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="pricing-pro"
          >
            Go Pro
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </article>
      </div>
      <p class="pricing-trust">
        No ads on any plan. We make money from Pro, not from your data.
        <a href={paths.route('/pricing/')}>Full pricing and FAQ</a>
      </p>
    </div>
  </section>

  <FaqSection eyebrow="Common questions" heading="Quick answers." faqs={homeFaqs} />

  <CtaSection />
</BaseLayout>

<style>
  /* Hero: a soft gradient stage so the product image has somewhere to sit. */
  .hero-band {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 78% 20%, rgba(255, 138, 76, 0.22), transparent 70%),
      radial-gradient(50% 60% at 12% 90%, rgba(120, 110, 240, 0.12), transparent 70%),
      linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero {
    align-items: center;
  }

  /* Sized to fit the hero copy column so the forced break gives exactly
     two clean lines on desktop. */
  .hero-title {
    font-size: clamp(2.4rem, 5.1vw, 3.9rem);
    line-height: 1.08;
    max-width: none;
  }

  .hero-break {
    display: none;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-visual :global(.shot) {
    transform: rotate(2.5deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .hero-visual :global(.shot:hover) {
    transform: rotate(0deg);
  }

  @media (min-width: 921px) {
    .hero-break {
      display: block;
    }
  }

  @media (max-width: 920px) {
    .hero-visual :global(.shot) {
      transform: none;
    }
  }

  .hero-sub {
    margin-top: 20px;
  }

  .cta-subtext {
    margin: 16px 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  /* Pricing lists: no repeating icons. A thin rule per row reads cleaner. */
  .plan-list {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    flex: 1;
  }

  .plan-list li {
    padding: 11px 0;
    font-size: var(--text-base);
    color: var(--ink);
    border-top: 1px solid var(--line);
  }

  .plan-list li:first-child {
    border-top: 0;
  }
</style>
